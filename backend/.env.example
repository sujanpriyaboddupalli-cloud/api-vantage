PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/api-sentinel
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8080
# consecutive failed checks before an incident is opened
FAILURE_THRESHOLD=3
# master cron cadence (every minute); each monitor is checked on its own interval
CHECK_CRON=* * * * *

# Must match the frontend VITE_GOOGLE_CLIENT_ID (verifies Google ID tokens)
GOOGLE_CLIENT_ID=

# Email alerts (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=API Sentinel <you@gmail.com>
