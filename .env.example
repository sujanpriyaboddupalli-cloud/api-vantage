# Point at your Express + MongoDB backend (see ./backend)
VITE_API_BASE_URL=http://localhost:4000/api
# "false" = use the real API, "true"/unset = local per-account demo data
VITE_USE_MOCK_API=false
# Google OAuth client ID (publishable) — enables "Continue with Google".
# Google Cloud Console → Credentials → OAuth client ID → Web application.
VITE_GOOGLE_CLIENT_ID=
